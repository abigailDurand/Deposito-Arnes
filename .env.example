# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
# Variables de SPEC-00 §5. (obligatoria) = el servicio no arranca sin ella.

PORT=3000
LOG_LEVEL=info
# Saltos de proxy de confianza (hay un API Gateway delante).
TRUST_PROXY=1

# (obligatoria) En docker compose se sobrescribe para apuntar al servicio "db".
DATABASE_URL=postgres://deposito:deposito@localhost:5432/deposito
# Solo pruebas. Si se omite, tests/setup/env.js usa .../deposito_test en localhost.
DATABASE_URL_TEST=postgres://deposito:deposito@localhost:5432/deposito_test

MANIFEST_PATH=specs-v2/manifest.yaml

# (obligatoria) Clave pública PEM de usuario-service en una sola línea, con \n escritos.
# En desarrollo: node scripts/generar-claves-dev.js (SPEC-02) y copia .dev-keys/ aquí.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ALGORITHMS=RS256
JWT_ISSUER=usuario-service
JWT_AUDIENCE=banco-api

IDEMPOTENCIA_DIAS=7

# (obligatoria) En docker compose se sobrescribe para apuntar a "billetera-mock".
BILLETERA_URL=http://localhost:4000
# (obligatoria) Autenticación entre servicios [POR ACORDAR] con el equipo de billetera (P3).
BILLETERA_TOKEN=cambiar-por-el-token-acordado
BILLETERA_TIMEOUT_MS=5000

# Opcionales. Valor real [POR ACORDAR] según normativa SBS vigente (SPEC-12, P6).
UIF_UMBRAL_PEN=
UIF_UMBRAL_USD=
