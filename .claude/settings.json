{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger-specs.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pruebas-rapidas.js\"",
            "timeout": 150
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verificacion-final.js\"",
            "timeout": 200
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash init.sh)",
      "Bash(bash init.sh --rapido)",
      "Bash(node .harness/specs.js verificar)",
      "Bash(node .harness/validar-features.js)",
      "Bash(node .harness/alcance.js)",
      "Bash(npm install)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npx jest*)",
      "Bash(docker compose up -d db)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)"
    ],
    "deny": [
      "Bash(node .harness/specs.js generar)"
    ]
  }
}
